# توکن ربات تلگرام؛ از BotFather بگیرید
TELEGRAM_BOT_TOKEN=123456:ABC-your-telegram-bot-token

# کلید API دیپ‌سیک؛ از platform.deepseek.com بگیرید
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# اختیاری: آدرس پایه‌ی API دیپ‌سیک (به‌ندرت نیاز به تغییر دارد)
DEEPSEEK_BASE_URL=https://api.deepseek.com

# اختیاری: انتخاب مدل
# deepseek-chat      -> مدل V3، برای مکالمه‌ی عمومی و سریع (پیش‌فرض)
# deepseek-reasoner  -> مدل R1، برای استدلال عمیق‌تر ولی کندتر و گران‌تر
MODEL_NAME=deepseek-chat

# اختیاری: سایر تنظیمات (مقادیر پیش‌فرض کار می‌کنند)
MAX_HISTORY_MESSAGES=12
MAX_OUTPUT_TOKENS=1024
STREAM_EDIT_INTERVAL=0.7
MIN_SECONDS_BETWEEN_REQUESTS=1.0
